---
interface Props {
	id: string;
	name: string;
	description: string;
	price: number;
	image: string;
}

const { id, name, description, price, image } = Astro.props;
---

<a href={`/product/${id}`} class="product-card">
	<div class="product-card-image">
		<img src={image} alt={name} loading="lazy" />
	</div>
	<div class="product-card-body">
		<h3>{name}</h3>
		<p>{description}</p>
		<span class="product-card-price">¥{price.toLocaleString()}</span>
	</div>
</a>

<style>
	.product-card {
		display: flex;
		flex-direction: column;
		border-radius: var(--radius);
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		overflow: hidden;
		transition: box-shadow 0.2s, transform 0.2s;
		color: var(--color-text);
	}

	.product-card:hover {
		box-shadow: var(--shadow-lg);
		transform: translateY(-2px);
		color: var(--color-text);
	}

	.product-card-image {
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: var(--color-bg-secondary);
	}

	.product-card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.product-card-body {
		padding: 16px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		flex: 1;
	}

	.product-card-body h3 {
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.product-card-body p {
		font-size: 0.8125rem;
		color: var(--color-text-secondary);
		line-height: 1.5;
		flex: 1;
	}

	.product-card-price {
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--color-primary);
	}
</style>
