---
interface Props {
	current: number;
	total: number;
	basePath: string;
}

const { current, total, basePath } = Astro.props;
---

{total > 1 && (
	<nav class="pagination" aria-label="分页导航">
		{current > 1 && (
			<a href={`${basePath}/${current - 1}`} class="pagination-btn" aria-label="上一页">上一页</a>
		)}
		{Array.from({ length: total }, (_, i) => i + 1).map((page) => (
			<a
				href={page === 1 ? basePath : `${basePath}/${page}`}
				class:list={['pagination-btn', { active: page === current }]}
				aria-current={page === current ? 'page' : undefined}
			>
				{page}
			</a>
		))}
		{current < total && (
			<a href={`${basePath}/${current + 1}`} class="pagination-btn" aria-label="下一页">下一页</a>
		)}
	</nav>
)}

<style>
	.pagination {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 8px;
		padding: 32px 0;
	}

	.pagination-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 36px;
		height: 36px;
		padding: 0 12px;
		border-radius: var(--radius);
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--color-text-secondary);
		border: 1px solid var(--color-border);
		transition: all 0.2s;
	}

	.pagination-btn:hover {
		color: var(--color-primary);
		border-color: var(--color-primary);
	}

	.pagination-btn.active {
		background: var(--color-primary);
		color: #fff;
		border-color: var(--color-primary);
	}
</style>
