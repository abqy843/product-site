---
---

<header class="nav">
	<div class="container nav-inner">
		<a href="/" class="nav-logo">产品官网</a>
		<nav class="nav-links">
			<a href="/">首页</a>
			<a href="/products">产品</a>
		</nav>
	</div>
</header>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 64px;
	}

	.nav-logo {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--color-text);
	}

	.nav-logo:hover {
		color: var(--color-primary);
	}

	.nav-links {
		display: flex;
		gap: 24px;
	}

	.nav-links a {
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--color-text-secondary);
		transition: color 0.2s;
	}

	.nav-links a:hover {
		color: var(--color-primary);
	}
</style>
