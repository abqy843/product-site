---
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
	const allProducts = await getCollection('products');
	return allProducts.map((entry) => ({
		params: { id: entry.id },
		props: { product: entry.data },
	}));
}

const { id } = Astro.params;
const entry = await getEntry('products', id!);
const product = entry!.data;

import Layout from '../../layouts/Layout.astro';

export const prerender = true;

function getSpecsMap(data: typeof product): Record<string, string> {
	const result: Record<string, string> = {};
	if (data.specs.spec1Key && data.specs.spec1Value) result[data.specs.spec1Key] = data.specs.spec1Value;
	if (data.specs.spec2Key && data.specs.spec2Value) result[data.specs.spec2Key] = data.specs.spec2Value;
	if (data.specs.spec3Key && data.specs.spec3Value) result[data.specs.spec3Key] = data.specs.spec3Value;
	if (data.specs.spec4Key && data.specs.spec4Value) result[data.specs.spec4Key] = data.specs.spec4Value;
	return result;
}

const specsMap = getSpecsMap(product);
---

<Layout title={`${product.name} - 产品详情`} description={product.description}>
	<section class="product-detail">
		<div class="container">
			<a href="/products" class="back-link">← 返回产品列表</a>
			<div class="product-layout">
				<div class="product-image">
					<img src={product.image} alt={product.name} />
				</div>
				<div class="product-info">
					<span class="product-category">{product.category}</span>
					<h1>{product.name}</h1>
					<p class="product-price">¥{product.price.toLocaleString()}</p>
					<p class="product-desc">{product.details}</p>
					{Object.keys(specsMap).length > 0 && (
						<div class="product-specs">
							<h2>产品规格</h2>
							<table>
								<tbody>
									{Object.entries(specsMap).map(([key, value]) => (
										<tr>
											<td class="spec-key">{key}</td>
											<td>{value}</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					)}
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.product-detail {
		padding: 32px 0 64px;
	}

	.back-link {
		display: inline-block;
		font-size: 0.875rem;
		color: var(--color-text-secondary);
		margin-bottom: 24px;
		transition: color 0.2s;
	}

	.back-link:hover {
		color: var(--color-primary);
	}

	.product-layout {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 48px;
		align-items: start;
	}

	.product-image {
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--color-bg-secondary);
		aspect-ratio: 4 / 3;
	}

	.product-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.product-info {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.product-category {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--color-primary);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.product-info h1 {
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.product-price {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--color-primary);
	}

	.product-desc {
		font-size: 0.9375rem;
		color: var(--color-text-secondary);
		line-height: 1.7;
	}

	.product-specs {
		margin-top: 16px;
	}

	.product-specs h2 {
		font-size: 1rem;
		font-weight: 600;
		margin-bottom: 12px;
	}

	.product-specs table {
		width: 100%;
		border-collapse: collapse;
	}

	.product-specs td {
		padding: 8px 12px;
		font-size: 0.875rem;
		border-bottom: 1px solid var(--color-border);
	}

	.spec-key {
		font-weight: 500;
		color: var(--color-text-secondary);
		width: 120px;
	}

	@media (max-width: 768px) {
		.product-layout {
			grid-template-columns: 1fr;
			gap: 24px;
		}
	}
</style>
